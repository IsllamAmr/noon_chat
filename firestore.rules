rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function inChat(chatId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 50;
    }

    function validNameLower(nameLower) {
      return nameLower is string && nameLower.size() > 0 && nameLower.size() <= 50;
    }

    function validStatus(status) {
      return status is string && status.size() <= 70;
    }

    function validChatCreate(data) {
      return data.participants is list &&
        data.participants.size() >= 1 &&
        data.participants.size() <= 2 &&
        request.auth.uid in data.participants &&
        data.keys().hasAll(['participants']) &&
        data.keys().hasOnly([
          'participants',
          'createdBy',
          'createdAt',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'chatType',
          'updatedAt',
          'disappearingSeconds',
          'typing',
          'seenAt',
          'deliveredAt'
        ]);
    }

    function _mapOrEmpty(value) {
      return value is map ? value : {};
    }

    function _onlyAuthKeyChanged(beforeMap, afterMap) {
      return afterMap.diff(beforeMap).affectedKeys().hasOnly([request.auth.uid]);
    }

    function _validTypingUpdate() {
      let beforeTyping = _mapOrEmpty(resource.data.typing);
      let afterTyping = _mapOrEmpty(request.resource.data.typing);
      return _onlyAuthKeyChanged(beforeTyping, afterTyping) &&
        afterTyping[request.auth.uid] is bool;
    }

    function _validSeenUpdate() {
      let beforeSeen = _mapOrEmpty(resource.data.seenAt);
      let afterSeen = _mapOrEmpty(request.resource.data.seenAt);
      return _onlyAuthKeyChanged(beforeSeen, afterSeen) &&
        afterSeen[request.auth.uid] is timestamp;
    }

    function _validDeliveredUpdate() {
      let beforeDelivered = _mapOrEmpty(resource.data.deliveredAt);
      let afterDelivered = _mapOrEmpty(request.resource.data.deliveredAt);
      return _onlyAuthKeyChanged(beforeDelivered, afterDelivered) &&
        afterDelivered[request.auth.uid] is timestamp;
    }

    function _canUpdateChatMetadataOnSend() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'updatedAt',
          'typing',
          'seenAt',
          'deliveredAt'
        ]) &&
        request.resource.data.lastSenderId == request.auth.uid &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() <= 2000 &&
        request.resource.data.lastMessageAt is timestamp &&
        _validTypingUpdate() &&
        _validSeenUpdate() &&
        _validDeliveredUpdate();
    }

    function _canSetTyping() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['typing', 'updatedAt']) &&
        _validTypingUpdate();
    }

    function _canSetSeen() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['seenAt']) &&
        _validSeenUpdate();
    }

    function _canSetDelivered() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['deliveredAt']) &&
        _validDeliveredUpdate();
    }

    function _canSetDisappearingTimer() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['disappearingSeconds', 'updatedAt']) &&
        request.resource.data.disappearingSeconds is int &&
        request.resource.data.disappearingSeconds >= 0 &&
        request.resource.data.disappearingSeconds <= 7 * 24 * 60 * 60;
    }

    function _canUpdateLastMessagePreviewOnly() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['lastMessage', 'updatedAt']) &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() <= 2000 &&
        resource.data.lastSenderId == request.auth.uid;
    }

    function chatFieldsCanUpdate() {
      return request.resource.data.participants == resource.data.participants &&
        request.resource.data.chatType == resource.data.chatType &&
        request.resource.data.createdBy == resource.data.createdBy &&
        (
          _canUpdateChatMetadataOnSend() ||
          _canUpdateLastMessagePreviewOnly() ||
          _canSetTyping() ||
          _canSetSeen() ||
          _canSetDelivered() ||
          _canSetDisappearingTimer()
        );
    }

    function chatJoinByInviteUpdate() {
      return signedIn() &&
        !(request.auth.uid in resource.data.participants) &&
        resource.data.chatType == 'direct' &&
        resource.data.participants is list &&
        resource.data.participants.size() == 1 &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.hasAll(resource.data.participants) &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['participants', 'updatedAt', 'lastMessageAt']);
    }

    function validMessage(data) {
      return data.senderId == request.auth.uid &&
        data.type in ['text', 'image', 'file', 'audio', 'call'] &&
        data.createdAt is timestamp &&
        (!('text' in data) || (data.text is string && data.text.size() <= 2000)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000)) &&
        (!('fileUrl' in data) || (data.fileUrl is string && data.fileUrl.size() <= 2000)) &&
        (!('callLink' in data) || (data.callLink is string && data.callLink.size() <= 2000)) &&
        (!('callType' in data) || data.callType in ['voice', 'video']) &&
        (!('forwarded' in data) || data.forwarded is bool) &&
        (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 120)) &&
        (!('fileSize' in data) || (data.fileSize is int && data.fileSize <= 25 * 1024 * 1024)) &&
        (!('durationMs' in data) || (data.durationMs is int && data.durationMs <= 10 * 60 * 1000)) &&
        (!('replyTo' in data) || data.replyTo is map) &&
        (!('reactions' in data) || data.reactions is map) &&
        (!('expiresAt' in data) || data.expiresAt is timestamp);
    }

    function canUpdateReactions() {
      let beforeReactions = _mapOrEmpty(resource.data.reactions);
      let afterReactions = _mapOrEmpty(request.resource.data.reactions);
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions']) &&
        afterReactions.diff(beforeReactions).affectedKeys().hasOnly([request.auth.uid]) &&
        (!(request.auth.uid in afterReactions) ||
          (
            afterReactions[request.auth.uid] is string &&
            afterReactions[request.auth.uid].size() <= 8
          )) &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.type == resource.data.type;
    }

    function canHideMessageForSelf() {
      let beforeHidden = resource.data.hiddenBy is list ? resource.data.hiddenBy : [];
      let afterHidden = request.resource.data.hiddenBy is list ? request.resource.data.hiddenBy : [];
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['hiddenBy', 'updatedAt']) &&
        afterHidden.hasAll(beforeHidden) &&
        request.auth.uid in afterHidden &&
        (
          (
            request.auth.uid in beforeHidden &&
            afterHidden.size() == beforeHidden.size()
          ) ||
          (
            !(request.auth.uid in beforeHidden) &&
            afterHidden.size() == beforeHidden.size() + 1
          )
        ) &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.type == resource.data.type;
    }

    function canEditTextMessage() {
      return request.auth.uid == resource.data.senderId &&
        resource.data.type == 'text' &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['text', 'editedAt', 'updatedAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000;
    }

    function canDeleteForEveryone() {
      return request.auth.uid == resource.data.senderId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'deletedForEveryone', 'deletedAt', 'deletedBy',
          'text', 'imageUrl', 'fileUrl', 'audioUrl',
          'fileName', 'durationMs', 'replyTo', 'updatedAt'
        ]) &&
        request.resource.data.deletedForEveryone == true &&
        request.resource.data.deletedBy == request.auth.uid;
    }

    function validInbox(data) {
      return
      (!('chatId' in data) || data.chatId is string) &&
      (!('peerUid' in data) || (data.peerUid is string && data.peerUid.size() <= 128)) &&
      (!('title' in data) || (data.title is string && data.title.size() <= 80)) &&
      (!('photo' in data) || (data.photo is string && data.photo.size() <= 2000)) &&
      (!('lastText' in data) || (data.lastText is string && data.lastText.size() <= 2000)) &&
      (!('type' in data) || (data.type is string && data.type.size() <= 32)) &&
      (!('unread' in data) || (data.unread is int && data.unread >= 0));
    }

    function participantCanWriteInbox(uid, chatId, data) {
      return signedIn() &&
        ('chatId' in data) &&
        data.chatId == chatId &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
        uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid) &&
        (!('name' in request.resource.data) || validName(request.resource.data.name)) &&
        (!('nameLower' in request.resource.data) || validNameLower(request.resource.data.nameLower)) &&
        (!('status' in request.resource.data) || validStatus(request.resource.data.status));
      allow delete: if isMe(uid);
    }

    match /users/{uid}/fcmTokens/{token} {
      allow read, write: if isMe(uid);
    }

    match /users/{uid}/inbox/{chatId} {
      allow read: if isMe(uid);
      allow create, update: if
        validInbox(request.resource.data) &&
        (
          isMe(uid) ||
          participantCanWriteInbox(uid, chatId, request.resource.data)
        );
      allow delete: if isMe(uid);
    }

    match /chats/{chatId} {
      allow read: if inChat(chatId);
      allow create: if signedIn() && validChatCreate(request.resource.data);
      allow update: if
        (inChat(chatId) && chatFieldsCanUpdate()) ||
        chatJoinByInviteUpdate();
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if inChat(chatId);
      allow create: if inChat(chatId) && validMessage(request.resource.data);
      allow update: if inChat(chatId) &&
        (canUpdateReactions() || canHideMessageForSelf() || canEditTextMessage() || canDeleteForEveryone());
      allow delete: if false;
    }

    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.inviterUid == request.auth.uid &&
        request.resource.data.code == code;
      allow update: if signedIn() &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.chatId == resource.data.chatId &&
        request.resource.data.inviterUid == resource.data.inviterUid &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['usedBy', 'usedAt']) &&
        (
          (resource.data.usedBy == null &&
            request.resource.data.usedBy == request.auth.uid) ||
          (resource.data.usedBy == request.auth.uid &&
            request.resource.data.usedBy == request.auth.uid) ||
          (
            resource.data.usedBy == resource.data.inviterUid &&
            request.auth.uid != resource.data.inviterUid &&
            request.resource.data.usedBy == request.auth.uid &&
            exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
            get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants is list &&
            get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants.size() == 1 &&
            resource.data.inviterUid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants
          )
        );
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'uid', 'type', 'text', 'mediaUrl', 'createdAt', 'expiresAt',
          'viewers', 'updatedAt'
        ]) &&
        request.resource.data.type in ['text', 'image'] &&
        (!(request.resource.data.text is string) || request.resource.data.text.size() <= 700) &&
        (!(request.resource.data.mediaUrl is string) || request.resource.data.mediaUrl.size() <= 2000);
      allow update: if signedIn() && (
        request.auth.uid == resource.data.uid ||
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['viewers', 'updatedAt']) &&
          request.resource.data.viewers is list &&
          resource.data.viewers is list &&
          request.resource.data.viewers.hasAll(resource.data.viewers) &&
          request.resource.data.viewers.size() <= resource.data.viewers.size() + 1 &&
          request.auth.uid in request.resource.data.viewers
        )
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;
    }
  }
}
